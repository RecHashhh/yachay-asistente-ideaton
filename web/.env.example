# URL de FastAPI. Déjala vacía para usar el agente simulado del frontend.
VITE_API_URL=http://localhost:8000

# Yachay Maps Geo API (modo de pruebas, sin LLM).
# En desarrollo, el proxy /__maps_api apunta a la API unificada en http://127.0.0.1:8000.
# MAP_TEST_MODE=true
# VITE_MAP_API_URL=/__maps_api

# Fondo satelital opcional. Por defecto usa Esri World Imagery.
# El endpoint no otorga licencia: revisa docs/SATELLITE_BASEMAP.md antes de desplegar.
# VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# VITE_SATELLITE_ATTRIBUTION=Source: Esri, Vantor, Earthstar Geographics, and the GIS User Community
