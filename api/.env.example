# Copiar a api/.env y completar. api/.env NO se sube al repositorio.

# Base creada con sql/00_crear_base.sql (usuario y base "yachi").
DATABASE_URL=postgresql://yachi:CONTRASEÑA@localhost:5432/yachi

# Clave de la API de Anthropic (consola: platform.claude.com). No pegarla en el chat ni en el código.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Carpeta del corpus preparado por el equipo (chunks.jsonl, fuentes.csv, datos/). Está fuera del repositorio.
RAG_DIR=../docs/rag/rag

# Modelo de embeddings local (se descarga una vez, ~220 MB).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Portal de administración (prototipo). En producción: Microsoft Entra ID de la universidad.
ADMIN_EMAILS=admin@yachaytech.edu.ec
ADMIN_PASSWORD=

# Origen del frontend permitido (CORS).
FRONTEND_ORIGIN=http://localhost:5180
