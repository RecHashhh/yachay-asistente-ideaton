# Copia este archivo a .env (docker compose). Estas credenciales son solo para desarrollo local.
POSTGRES_DB=yachi
POSTGRES_USER=yachay
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432
API_PORT=8000

# Portal de administración (prototipo): correos separados por coma y contraseña de 12 caracteres o más.
ADMIN_EMAILS=
ADMIN_PASSWORD=

# Con clave, el agente elige en qué documentos buscar y Claude redacta con citas; sin clave, búsqueda directa y fragmento literal.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# auto (agente si hay clave) | off (siempre búsqueda directa)
YACHI_AGENT=auto

# Umbral de similitud coseno y cantidad de fragmentos que recibe el modelo; calibrar con el set de control.
RAG_MIN_SIMILARITY=0.30
RAG_CONTEXT_CHUNKS=8
RAG_MAX_TOOL_CALLS=6
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Ingesta de comunicados por correo (POST /ingest/email, cabecera X-Ingest-Token).
# Sin token el endpoint queda deshabilitado. Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=
# Remitentes aceptados, separados por coma (el buzón robot reenvía solo lo que llega de ellos).
EMAIL_ALLOWED_SENDERS=comunicacion@yachaytech.edu.ec

# Solo para el perfil opcional "ollama" (capa de indexación original): modelo de embeddings de Ollama.
OLLAMA_EMBEDDING_MODEL=bge-m3
