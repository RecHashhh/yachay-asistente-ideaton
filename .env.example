# Copia este archivo a .env. Estas credenciales son solo para desarrollo local.
POSTGRES_DB=yachay_rag
POSTGRES_USER=yachay
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432
API_PORT=8000

# Ollama descarga este modelo al volumen ollama_data y lo usa para indexación y consultas.
OLLAMA_EMBEDDING_MODEL=bge-m3

# Requerida para generar respuestas del agente.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Umbral inicial de similitud coseno; configurable para calibrarlo con preguntas reales.
RAG_MIN_SIMILARITY=0.30
RAG_VECTOR_CANDIDATES=20
RAG_CONTEXT_CHUNKS=4
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
